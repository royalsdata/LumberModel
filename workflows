
name: Update Lumber+ Leaderboard

on:
  schedule:
    # Runs daily at 9am ET (1pm UTC) — after Savant updates overnight data
    - cron: "0 13 * * *"
  workflow_dispatch:
    # Also allows manual trigger from GitHub Actions tab at any time

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install pandas requests

      - name: Run Lumber+ update script
        run: python lumber_plus_update.py --year 2026 --min-pa 50

      - name: Commit updated leaderboard
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add lumber_plus_leaderboard.html
          # Only commit if the file actually changed
          git diff --cached --quiet || git commit -m "Auto-update: Lumber+ 2026 data $(date +'%Y-%m-%d')"
          git push
